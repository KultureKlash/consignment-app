generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String   @id
  shop          String
  state         String
  isOnline      Boolean  @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean  @default(false)
  locale        String?
  collaborator  Boolean? @default(false)
  emailVerified Boolean? @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Consignor {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  feeRate        Float    @default(0.15)  // consignment fee — e.g. 0.15 = 15% fee, consignor keeps 85%

  notificationsReadAt DateTime?

  listings       Listing[]
  payouts        Payout[]
  transactions   Transaction[]

  createdAt      DateTime @default(now())
}

model Product {
  id                String   @id @default(cuid())
  title             String
  brand             String?
  category          String?
  styleId           String?  @unique
  description       String?
  imageUrl          String?   // Shopify-hosted product image URL

  shopifyProductId  String?  @unique

  variants          Variant[]

  createdAt         DateTime @default(now())
}

model Variant {
  id                 String   @id @default(cuid())
  productId          String
  size               String
  gtin               String?  @unique

  shopifyVariantId   String?  @unique
  inventoryItemId    String?

  product            Product  @relation(fields: [productId], references: [id])
  listings           Listing[]

  createdAt          DateTime @default(now())

  @@unique([productId, size])
}

model Listing {
  id              String    @id @default(cuid())
  consignorId     String
  variantId       String

  price           Float
  status          String    @default("active") // "active" | "sold" | "cancelled"

  // Lifecycle timestamps
  createdAt       DateTime  @default(now())
  receivedAt      DateTime?
  authenticatedAt DateTime?
  listedAt        DateTime?
  soldAt          DateTime?
  withdrawnAt     DateTime?

  // Reassignment tracking (populated only for post-payout refund reassignments)
  reassignedFromConsignorId  String?
  reassignedFromListingId    String?

  consignor       Consignor @relation(fields: [consignorId], references: [id])
  variant         Variant   @relation(fields: [variantId], references: [id])

  orderItems      OrderItem[]

  @@index([variantId, status, price, createdAt])
  @@index([consignorId, status, createdAt])
}

model Order {
  id            String      @id @default(cuid())
  shopifyId     String?     @unique
  orderNumber   String?     // Shopify order name e.g. "#KK1042"
  total         Float
  status        String      @default("open")
  paymentStatus String      @default("pending") // "pending" | "paid"

  items     OrderItem[]

  createdAt DateTime @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  listingId String

  price     Float
  status    String   @default("sold") // "sold" | "refunded"

  order     Order    @relation(fields: [orderId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id               String     @id @default(cuid())
  consignorId      String
  orderItemId      String?
  type             String          // "sale" | "refund"

  // Audit-grade breakdown (immutable snapshot at creation time)
  salePrice        Float    @default(0) // unit price at time of sale
  feeRate          Float    @default(0) // fee rate snapshot — e.g. 0.15 = 15%
  grossAmount      Float    @default(0) // salePrice (per-item, always 1 unit)
  feeAmount        Float    @default(0) // grossAmount × feeRate
  consignorAmount  Float    @default(0) // grossAmount × (1 - feeRate)

  // Net amount for balance calculations
  // Sales: +consignorAmount. Refunds: -consignorAmount
  amount           Float

  consignor        Consignor  @relation(fields: [consignorId], references: [id])
  orderItem        OrderItem? @relation(fields: [orderItemId], references: [id])
  payoutItems      PayoutItem[]

  createdAt        DateTime @default(now())
}

model WebhookEvent {
  id              String    @id @default(cuid())
  shopifyEventId  String    @unique
  topic           String
  shopifyObjectId String
  status          String    @default("processing") // "processing" | "completed" | "failed"
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model Payout {
  id           String   @id @default(cuid())
  consignorId  String
  amount       Float
  status       String   @default("pending") // "pending" | "invoiced" | "paid"

  consignor    Consignor @relation(fields: [consignorId], references: [id])
  items        PayoutItem[]

  createdAt    DateTime @default(now())
}

model PayoutItem {
  id            String      @id @default(cuid())
  payoutId      String
  transactionId String

  payout        Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([payoutId, transactionId])
}

model ReassignmentLog {
  id                    String   @id @default(cuid())
  originalListingId     String
  newListingId          String
  originalConsignorId   String
  newConsignorId        String
  orderId               String?
  reason                String   // "post_payout_refund"
  createdAt             DateTime @default(now())
}