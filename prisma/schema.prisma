generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")        // pooled connection — runtime queries
  directUrl = env("DIRECT_DATABASE_URL") // non-pooled — for migrations (needs advisory locks)
}

model Session {
  id            String   @id
  shop          String
  state         String
  isOnline      Boolean  @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean  @default(false)
  locale        String?
  collaborator  Boolean? @default(false)
  emailVerified Boolean? @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Consignor {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?                 // consignor phone number
  taxStatus      String   @default("individual") // "individual" | "business"
  province       String?                 // Canadian province code (e.g. "QC", "ON") — required for business
  gstNumber      String?                 // GST/HST registration number
  qstNumber      String?                 // QST number (Quebec only)
  storeOwned     Boolean  @default(false)  // true = store-owned inventory, excluded from payouts
  // feeRate stays Float on purpose. Every money COLUMN is Decimal(10,2), but a
  // fee rate is a ratio, not an amount: it has no currency, no 2-decimal
  // meaning, and is never summed, compared against a balance, or paid out.
  // Making it Decimal would buy nothing and would force a Decimal multiply in
  // the one place that must stay integer arithmetic — calculateFee converts
  // gross to integer cents and multiplies by this rate there, which is why
  // rounding lives in that single function.
  feeRate        Float    @default(0.15)  // consignment fee — e.g. 0.15 = 15% fee, consignor keeps 85%
  status         String   @default("active") // "active" | "suspended"
  suspensionReason String?               // admin-provided reason for suspension
  suspendedAt    DateTime?               // when the account was suspended
  avatarColor    String?                 // HSL color string for portal avatar badge
  notificationPrefs String?              // JSON: { disabled: string[] } — null = all enabled

  notificationsReadAt DateTime?

  listings       Listing[]
  payouts        Payout[]
  transactions   Transaction[]
  feedback       Feedback[]

  createdAt      DateTime @default(now())
}

model Product {
  id                String   @id @default(cuid())
  title             String
  brand             String?
  category          String?
  sku               String?  @unique @map("styleId")
  description       String?
  imageUrl          String?   // Shopify-hosted product image URL

  shopifyProductId  String?  @unique

  sectionId         String?
  section           StoreSection? @relation(fields: [sectionId], references: [id])

  variants          Variant[]

  createdAt         DateTime @default(now())
}

model StoreSection {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Variant {
  id                 String   @id @default(cuid())
  productId          String
  size               String
  gtin               String?  @unique

  shopifyVariantId   String?  @unique
  inventoryItemId    String?

  product            Product  @relation(fields: [productId], references: [id])
  listings           Listing[]

  createdAt          DateTime @default(now())

  @@unique([productId, size])
}

model Listing {
  id              String    @id @default(cuid())
  consignorId     String
  variantId       String

  price           Decimal?  @db.Decimal(10, 2) // null = awaiting_price (admin created without price, consignor will set)
  cost            Decimal?  @db.Decimal(10, 2) // acquisition cost (store-owned inventory only)
  status          String    @default("active") // "submitted" | "approved_awaiting_dropoff" | "awaiting_price" | "active" | "paused" | "pending_sale" | "sold" | "cancelled" | "rejected" | "withdrawal_requested" | "pending_pickup" | "withdrawn"

  // Lifecycle timestamps
  createdAt       DateTime  @default(now())
  submittedAt     DateTime? // consignor submitted for review
  approvedAt      DateTime? // admin approved
  rejectedAt      DateTime? // admin rejected
  rejectionReason String?   // admin reason for rejection
  receivedAt      DateTime?
  authenticatedAt DateTime?
  listedAt        DateTime?
  soldAt          DateTime?
  withdrawnAt     DateTime?  // set when consignor requests withdrawal
  withdrawalApprovedAt DateTime? // set when admin approves → pending_pickup

  // Reassignment tracking (populated only for post-payout refund reassignments)
  reassignedFromConsignorId  String?
  reassignedFromListingId    String?

  consignor       Consignor @relation(fields: [consignorId], references: [id])
  variant         Variant   @relation(fields: [variantId], references: [id])

  orderItems      OrderItem[]

  @@index([variantId, status, price, createdAt])
  @@index([consignorId, status, createdAt])
  @@index([soldAt])
}

model Order {
  id            String      @id @default(cuid())
  shopifyId     String?     @unique
  orderNumber   String?     // Shopify order name e.g. "#KK1042"
  total         Decimal     @db.Decimal(10, 2)
  status        String      @default("open")
  paymentStatus String      @default("pending") // "pending" | "paid"
  fulfilledAt   DateTime?

  // Shopify line items with no local Variant — gift cards, products created
  // outside this app, deleted variants. Recorded rather than aborting the order
  // so the consignment items in the same cart still settle. Shape:
  // [{ shopifyVariantId, quantity, price, reason }]
  unmappedLineItems Json?

  // What Shopify says the customer was charged. Bookkeeping only — these never
  // feed a consignor credit (see the discount rule in CLAUDE.md). `total` above
  // stays the sum of allocated listing prices in every code path, so the two are
  // never interchangeable: `total` is what we owe consignors against, these are
  // what the customer paid.
  shopifySubtotal  Decimal? @db.Decimal(10, 2) // line items after line-level discounts, pre-tax, pre-shipping
  shopifyDiscounts Decimal? @db.Decimal(10, 2) // total discount applied to the order
  shopifyTax       Decimal? @db.Decimal(10, 2)
  shopifyShipping  Decimal? @db.Decimal(10, 2)
  shopifyTotal     Decimal? @db.Decimal(10, 2) // grand total charged, incl. tax + shipping

  items     OrderItem[]

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  listingId String

  price     Decimal  @db.Decimal(10, 2)
  status    String   @default("sold") // "sold" | "pending_sale" | "refunded" — see ORDER_ITEM_STATUS

  order     Order    @relation(fields: [orderId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id               String     @id @default(cuid())
  consignorId      String
  orderItemId      String?
  type             String          // "sale" | "refund"

  // Audit-grade breakdown (immutable snapshot at creation time)
  salePrice        Decimal  @default(0) @db.Decimal(10, 2) // unit price at time of sale
  cost             Decimal  @default(0) @db.Decimal(10, 2) // acquisition cost snapshot (store-owned only, 0 for consignment)
  // feeRate is a RATE, not an amount — see the note on Consignor.feeRate.
  feeRate          Float    @default(0) // fee rate snapshot — e.g. 0.15 = 15%
  grossAmount      Decimal  @default(0) @db.Decimal(10, 2) // salePrice (per-item, always 1 unit)
  feeAmount        Decimal  @default(0) @db.Decimal(10, 2) // grossAmount × feeRate
  consignorAmount  Decimal  @default(0) @db.Decimal(10, 2) // grossAmount × (1 - feeRate)

  // Net amount for balance calculations
  // Sales: +consignorAmount. Refunds: -consignorAmount
  amount           Decimal  @db.Decimal(10, 2)

  consignor        Consignor  @relation(fields: [consignorId], references: [id])
  orderItem        OrderItem? @relation(fields: [orderItemId], references: [id])
  payoutItems      PayoutItem[]

  createdAt        DateTime @default(now())

  @@index([consignorId, type, createdAt])
  @@index([orderItemId, type])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  shopifyEventId  String    @unique
  topic           String
  shopifyObjectId String
  status          String    @default("processing") // "processing" | "completed" | "failed"
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  // Exactly what Shopify sent, stored before the handler runs. Lets a corrupted
  // order be replayed from source, and lets the reconciler compare the ledger
  // against Shopify's own numbers without an Admin API call per order.
  //
  // CONTAINS CUSTOMER PII (name, email, shipping address, phone). It is retained
  // only as long as the WebhookEvent row; prune it on the same schedule — see the
  // cleanup route. Do not surface it in the portal or any consignor-facing view.
  rawPayload      Json?

  @@index([topic, status, createdAt])
}

model Payout {
  id           String   @id @default(cuid())
  consignorId  String
  amount       Decimal  @db.Decimal(10, 2)
  status       String   @default("pending") // "pending" | "invoiced" | "paid"
  invoiceSent  Boolean  @default(false)      // auto-set when invoice uploaded
  invoiceData  String?                       // base64-encoded PDF
  invoiceFileName String?                    // original filename

  consignor    Consignor @relation(fields: [consignorId], references: [id])
  items        PayoutItem[]

  createdAt    DateTime @default(now())

  @@index([consignorId, status, createdAt])
}

model PayoutItem {
  id            String      @id @default(cuid())
  payoutId      String
  transactionId String

  payout        Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([payoutId, transactionId])
}

model ReassignmentLog {
  id                    String   @id @default(cuid())
  originalListingId     String
  newListingId          String
  originalConsignorId   String
  newConsignorId        String
  orderId               String?
  reason                String   // "post_payout_refund"
  createdAt             DateTime @default(now())
}

model OtpCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Feedback {
  id           String    @id @default(cuid())
  consignorId  String
  type         String    // "bug" | "suggestion" | "other"
  message      String
  status       String    @default("open") // "open" | "resolved"

  consignor    Consignor @relation(fields: [consignorId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
}