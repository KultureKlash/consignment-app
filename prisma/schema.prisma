generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String   @id
  shop          String
  state         String
  isOnline      Boolean  @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean  @default(false)
  locale        String?
  collaborator  Boolean? @default(false)
  emailVerified Boolean? @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Consignor {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?                 // consignor phone number
  taxStatus      String   @default("individual") // "individual" | "business"
  province       String?                 // Canadian province code (e.g. "QC", "ON") — required for business
  gstNumber      String?                 // GST/HST registration number
  qstNumber      String?                 // QST number (Quebec only)
  storeOwned     Boolean  @default(false)  // true = store-owned inventory, excluded from payouts
  feeRate        Float    @default(0.15)  // consignment fee — e.g. 0.15 = 15% fee, consignor keeps 85%
  status         String   @default("active") // "active" | "suspended"
  suspensionReason String?               // admin-provided reason for suspension
  suspendedAt    DateTime?               // when the account was suspended
  avatarColor    String?                 // HSL color string for portal avatar badge
  notificationPrefs String?              // JSON: { disabled: string[] } — null = all enabled

  notificationsReadAt DateTime?

  listings       Listing[]
  payouts        Payout[]
  transactions   Transaction[]
  feedback       Feedback[]

  createdAt      DateTime @default(now())
}

model Product {
  id                String   @id @default(cuid())
  title             String
  brand             String?
  category          String?
  sku               String?  @unique @map("styleId")
  description       String?
  imageUrl          String?   // Shopify-hosted product image URL

  shopifyProductId  String?  @unique

  sectionId         String?
  section           StoreSection? @relation(fields: [sectionId], references: [id])

  variants          Variant[]

  createdAt         DateTime @default(now())
}

model StoreSection {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Variant {
  id                 String   @id @default(cuid())
  productId          String
  size               String
  gtin               String?  @unique

  shopifyVariantId   String?  @unique
  inventoryItemId    String?

  product            Product  @relation(fields: [productId], references: [id])
  listings           Listing[]

  createdAt          DateTime @default(now())

  @@unique([productId, size])
}

model Listing {
  id              String    @id @default(cuid())
  consignorId     String
  variantId       String

  price           Float
  cost            Float?                // acquisition cost (store-owned inventory only)
  status          String    @default("active") // "submitted" | "approved_awaiting_dropoff" | "active" | "paused" | "pending_sale" | "sold" | "cancelled" | "rejected" | "withdrawal_requested" | "pending_pickup" | "withdrawn"

  // Lifecycle timestamps
  createdAt       DateTime  @default(now())
  submittedAt     DateTime? // consignor submitted for review
  approvedAt      DateTime? // admin approved
  rejectedAt      DateTime? // admin rejected
  rejectionReason String?   // admin reason for rejection
  receivedAt      DateTime?
  authenticatedAt DateTime?
  listedAt        DateTime?
  soldAt          DateTime?
  withdrawnAt     DateTime?  // set when consignor requests withdrawal
  withdrawalApprovedAt DateTime? // set when admin approves → pending_pickup

  // Reassignment tracking (populated only for post-payout refund reassignments)
  reassignedFromConsignorId  String?
  reassignedFromListingId    String?

  consignor       Consignor @relation(fields: [consignorId], references: [id])
  variant         Variant   @relation(fields: [variantId], references: [id])

  orderItems      OrderItem[]

  @@index([variantId, status, price, createdAt])
  @@index([consignorId, status, createdAt])
  @@index([soldAt])
}

model Order {
  id            String      @id @default(cuid())
  shopifyId     String?     @unique
  orderNumber   String?     // Shopify order name e.g. "#KK1042"
  total         Float
  status        String      @default("open")
  paymentStatus String      @default("pending") // "pending" | "paid"
  fulfilledAt   DateTime?

  items     OrderItem[]

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  listingId String

  price     Float
  status    String   @default("sold") // "sold" | "refunded"

  order     Order    @relation(fields: [orderId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id               String     @id @default(cuid())
  consignorId      String
  orderItemId      String?
  type             String          // "sale" | "refund"

  // Audit-grade breakdown (immutable snapshot at creation time)
  salePrice        Float    @default(0) // unit price at time of sale
  cost             Float    @default(0) // acquisition cost snapshot (store-owned only, 0 for consignment)
  feeRate          Float    @default(0) // fee rate snapshot — e.g. 0.15 = 15%
  grossAmount      Float    @default(0) // salePrice (per-item, always 1 unit)
  feeAmount        Float    @default(0) // grossAmount × feeRate
  consignorAmount  Float    @default(0) // grossAmount × (1 - feeRate)

  // Net amount for balance calculations
  // Sales: +consignorAmount. Refunds: -consignorAmount
  amount           Float

  consignor        Consignor  @relation(fields: [consignorId], references: [id])
  orderItem        OrderItem? @relation(fields: [orderItemId], references: [id])
  payoutItems      PayoutItem[]

  createdAt        DateTime @default(now())

  @@index([consignorId, type, createdAt])
  @@index([orderItemId, type])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  shopifyEventId  String    @unique
  topic           String
  shopifyObjectId String
  status          String    @default("processing") // "processing" | "completed" | "failed"
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([topic, status, createdAt])
}

model Payout {
  id           String   @id @default(cuid())
  consignorId  String
  amount       Float
  status       String   @default("pending") // "pending" | "invoiced" | "paid"
  invoiceSent  Boolean  @default(false)      // consignor self-reports invoice sent

  consignor    Consignor @relation(fields: [consignorId], references: [id])
  items        PayoutItem[]

  createdAt    DateTime @default(now())

  @@index([consignorId, status, createdAt])
}

model PayoutItem {
  id            String      @id @default(cuid())
  payoutId      String
  transactionId String

  payout        Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([payoutId, transactionId])
}

model ReassignmentLog {
  id                    String   @id @default(cuid())
  originalListingId     String
  newListingId          String
  originalConsignorId   String
  newConsignorId        String
  orderId               String?
  reason                String   // "post_payout_refund"
  createdAt             DateTime @default(now())
}

model OtpCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Feedback {
  id           String    @id @default(cuid())
  consignorId  String
  type         String    // "bug" | "suggestion" | "other"
  message      String
  status       String    @default("open") // "open" | "resolved"

  consignor    Consignor @relation(fields: [consignorId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
}